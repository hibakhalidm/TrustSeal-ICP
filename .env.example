# Hedera configuration
# Network: mainnet | testnet | previewnet
HEDERA_NETWORK=testnet

# Operator credentials (Account ID and private key)
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420...

# Optional: HTS NFT TokenId to mint credentials on (must be an NFT token)
HEDERA_NFT_TOKEN_ID=

# Optional: allow burning NFT on revoke (use with caution)
HEDERA_ALLOW_BURN=false
