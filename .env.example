# TrustSeal ICP Environment Configuration
# Copy this file to .env and update with your values

# Environment
NODE_ENV=development

# Internet Identity Canister ID (Development)
INTERNET_IDENTITY_CANISTER_ID=rdmx6-jaaaa-aaaaa-aaadq-cai

# TrustSeal Backend Canister ID (Development)
TRUSTSEAL_BACKEND_CANISTER_ID=rrkah-fqaaa-aaaaa-aaaaq-cai

# For Production, use mainnet canister IDs:
# INTERNET_IDENTITY_CANISTER_ID=<your-mainnet-internet-identity-id>
# TRUSTSEAL_BACKEND_CANISTER_ID=<your-mainnet-backend-id>

# Optional: Custom host for development
# ICP_HOST=http://localhost:4943
# ICP_HOST=https://icp-api.io